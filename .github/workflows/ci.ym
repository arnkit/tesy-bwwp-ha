name: CI
on: [push, pull_request]
jobs:
  host-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Decoder test (C++)
        run: tests/run.sh
      - uses: actions/setup-node@v4
        with: { node-version: 22 }
      - name: Archived Node-RED flow test
        run: node tests/test_flow.js
  esphome:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - run: pip install esphome
      - name: Prepare secrets
        working-directory: esphome
        run: |
          cp secrets.yaml.example secrets.yaml
          sed -i "s|REPLACE_WITH_BASE64_32_BYTE_KEY|$(openssl rand -base64 32)|" secrets.yaml
      - name: Validate config
        working-directory: esphome
        run: esphome config tesy-bwwp.yaml
      - name: Validate config incl. extra package
        working-directory: esphome
        run: |
          sed 's/^# packages:/packages:/;s/^#   extra:/  extra:/' tesy-bwwp.yaml > full.yaml
          esphome config full.yaml
      - name: Compile firmware
        working-directory: esphome
        run: esphome compile tesy-bwwp.yaml
